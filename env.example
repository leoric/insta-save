# Токен бота от @BotFather
TG_BOT_TOKEN=

# Твой Telegram user id (узнать у @userinfobot). Бот отвечает только ему.
TG_ALLOWED_USER_ID=

# Необязательно: логин Instagram, под которым выполнен `instaloader --login`
IG_USERNAME=

# Необязательно: папка для загрузок (по умолчанию ~/Downloads)
DOWNLOAD_DIR=~/Downloads
